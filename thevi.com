<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#020806">
<meta name="description" content="Thế Vĩ — Creative Developer chuyên web 3D, WebGL và Three.js. Xem dự án, nghe nhạc và liên hệ hợp tác.">
<title>Thế Vĩ — Creative Developer · Web 3D</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;800&family=Be+Vietnam+Pro:wght@400;500;600&display=swap">
<style>
:root{--g:#00ff9c;--c:#00d9ff;--m:#ff2bd6;--bg:#020806;--tx:#d6ffee;--mut:#7fb8a0;--pn:rgba(3,22,15,.66);--bd:rgba(0,255,156,.3);color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--tx);font:400 16.5px/1.75 "Be Vietnam Pro",system-ui,sans-serif;overflow-x:hidden}
.mono,nav,.term,.tags,.btn,h2,.name,.role,small,.bar-l{font-family:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace}
a{color:inherit}
::selection{background:var(--g);color:#001a10}
:focus-visible{outline:2px solid var(--m);outline-offset:3px}
#rain,#bg{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}
#rain{z-index:0;opacity:.28}#bg{z-index:1}
.scan{position:fixed;inset:0;z-index:60;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.2) 0 1px,transparent 1px 3px),radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.65))}
#glow{position:fixed;left:0;top:0;width:420px;height:420px;margin:-210px 0 0 -210px;z-index:2;pointer-events:none;background:radial-gradient(circle,rgba(0,255,156,.13),transparent 65%);transform:translate(50vw,50vh)}
#boot{position:fixed;inset:0;z-index:100;background:#010403;display:grid;align-content:center;padding:8vw}#boot.out{animation:bootOut .6s forwards}
#boot pre{margin:0;font:500 clamp(12px,2.4vw,16px)/1.9 "JetBrains Mono",monospace;color:var(--g);white-space:pre-wrap}
@keyframes bootOut{to{opacity:0;visibility:hidden}}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:14px 5vw;font-size:14px;background:linear-gradient(#020806e6,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
nav b{color:var(--g);text-shadow:0 0 14px var(--g)}
nav div{display:flex;gap:22px}nav a{text-decoration:none;color:var(--mut)}nav a:hover{color:var(--g)}
.wrap{position:relative;z-index:5}
.hero{min-height:100svh;display:grid;place-items:center;padding:100px 5vw 60px;perspective:1200px}
.stage{transform-style:preserve-3d;text-align:center;width:100%;max-width:880px}
.term{text-align:left;background:var(--pn);border:1px solid var(--bd);border-radius:14px;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:0 0 40px -12px var(--g);overflow:hidden;font-size:14px;max-width:520px;margin:0 auto 38px;transform:translateZ(40px)}
.bar{display:flex;align-items:center;gap:7px;padding:9px 14px;border-bottom:1px solid var(--bd);color:var(--mut);font-size:12.5px}
.bar i{width:10px;height:10px;border-radius:50%;background:#ff5f56}.bar i:nth-child(2){background:#ffbd2e}.bar i:nth-child(3){background:#27c93f}.bar span{margin-left:8px}
.tb{padding:14px 16px;min-height:76px}.tb p{margin:0}.tb b{color:var(--g)}.tb u{color:var(--c);text-decoration:none}.tb .o{color:var(--mut);opacity:0;transition:opacity .5s;margin-top:4px}.tb .o.on{opacity:1}
.cur{display:inline-block;width:.6em;height:1.05em;background:var(--g);vertical-align:-.18em;margin-left:2px;animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}
.name{position:relative;display:inline-block;margin:0;font-weight:800;font-size:clamp(64px,17vw,200px);line-height:1.05;letter-spacing:-.03em;transform-style:preserve-3d}
.name>span{position:absolute;left:0;top:0;white-space:nowrap}
.name .f{position:relative;color:var(--g);text-shadow:0 0 28px rgba(0,255,156,.7),0 0 80px rgba(0,255,156,.35);transform:translateZ(34px)}
.f::before,.f::after{content:attr(data-t);position:absolute;left:0;top:0;clip-path:inset(0 0 100% 0)}
.f::before{color:var(--c);animation:g1 3.4s infinite steps(1)}.f::after{color:var(--m);animation:g2 3.4s infinite steps(1)}
@keyframes g1{0%,88%,100%{clip-path:inset(0 0 100% 0);transform:none}89%{clip-path:inset(18% 0 58% 0);transform:translate(-7px)}92%{clip-path:inset(62% 0 12% 0);transform:translate(6px)}95%{clip-path:inset(40% 0 40% 0);transform:translate(-3px)}}
@keyframes g2{0%,90%,100%{clip-path:inset(0 0 100% 0);transform:none}91%{clip-path:inset(50% 0 28% 0);transform:translate(7px)}94%{clip-path:inset(8% 0 70% 0);transform:translate(-6px)}}
.role{margin:30px 0 0;font-size:clamp(16px,2.6vw,24px);color:var(--c);min-height:1.6em;transform:translateZ(56px)}
.cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:34px;transform:translateZ(70px)}
.btn{display:inline-block;padding:13px 24px;border:1px solid var(--g);color:var(--g);text-decoration:none;font-weight:500;font-size:15px;border-radius:6px;background:rgba(0,255,156,.06);cursor:pointer;transition:.25s}
.btn:hover,.btn.p{background:var(--g);color:#001a10;box-shadow:0 0 28px var(--g)}
.btn.p:hover{background:transparent;color:var(--g)}
section{max-width:1160px;margin:0 auto;padding:110px 5vw}
h2{font-weight:800;font-size:clamp(30px,5vw,54px);line-height:1.15;margin:0 0 16px}
h2 small{display:block;font-weight:500;font-size:15px;color:var(--g);margin-bottom:10px}
.lead{color:var(--mut);max-width:62ch;margin:0 0 46px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;perspective:1000px}
.card{position:relative;padding:28px 24px;background:var(--pn);border:1px solid var(--bd);border-radius:12px;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transform-style:preserve-3d;transition:transform .15s ease-out,border-color .3s,box-shadow .3s;overflow:hidden}
.card:hover{border-color:var(--g);box-shadow:0 0 36px -10px var(--g)}
.card::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(240px circle at var(--gx,50%) var(--gy,0%),rgba(0,255,156,.2),transparent 70%)}
.card h3{font:800 20px "JetBrains Mono",monospace;margin:0 0 8px;color:var(--g);transform:translateZ(34px)}
.card p{margin:0;color:var(--mut);font-size:15.5px;transform:translateZ(18px)}
.card .dots{display:flex;gap:6px;margin-bottom:18px;transform:translateZ(30px)}.dots i{width:9px;height:9px;border-radius:50%;background:var(--bd)}.dots i:first-child{background:var(--m)}.dots i:nth-child(2){background:var(--c)}.dots i:nth-child(3){background:var(--g)}
.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:12.5px;transform:translateZ(22px)}.tags i{font-style:normal;border:1px solid var(--bd);padding:2px 10px;border-radius:5px;color:var(--c)}
.stats{display:flex;flex-wrap:wrap;gap:clamp(28px,6vw,80px)}.stats div{font:800 clamp(40px,6vw,66px)/1 "JetBrains Mono",monospace;color:var(--g);text-shadow:0 0 22px rgba(0,255,156,.5)}.stats small{display:block;font:400 14px "Be Vietnam Pro",sans-serif;color:var(--mut);margin-top:8px;text-shadow:none}
.sk{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:26px 50px}
.bar-l{display:flex;justify-content:space-between;font-size:14px;margin-bottom:8px}.bar-l b{color:var(--g)}
.bt{height:8px;background:rgba(0,255,156,.12);border-radius:9px;overflow:hidden}.bt i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--g),var(--c));box-shadow:0 0 14px var(--g);transition:width 1.5s cubic-bezier(.2,.7,.2,1)}.on .bt i{width:var(--v)}
.contact{text-align:center}.contact .term{max-width:560px;margin:0 auto 30px;transform:none}.contact .tb a{color:var(--c);text-decoration:none}.contact .tb a:hover{color:var(--g)}
.contact .tb.pl{padding:10px}.pl iframe{display:block;width:100%;height:152px;border:0;border-radius:12px}
.bar .eq{margin:0 0 0 auto;display:flex;gap:3px;align-items:flex-end;height:12px}.eq b{width:3px;height:3px;background:var(--g);animation:eq 1s infinite ease-in-out}.eq b:nth-child(2){animation-delay:.25s}.eq b:nth-child(3){animation-delay:.5s}.eq b:nth-child(4){animation-delay:.75s}
@keyframes eq{50%{height:12px}}
.row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.pr{height:6px;margin:18px 0 8px;background:rgba(0,255,156,.12);border-radius:9px;overflow:hidden}.pr i{display:block;height:100%;width:var(--p,0%);background:linear-gradient(90deg,var(--g),var(--c));box-shadow:0 0 12px var(--g)}#tm{margin:0;color:var(--mut);font-size:12.5px;text-align:center}.eq b{animation-play-state:paused}.playing .eq b{animation-play-state:running}.contact .tb.pl{padding:18px}
.love{overflow:hidden;white-space:nowrap;border-block:1px solid var(--bd);background:rgba(255,43,214,.06);padding:8px 0;font:800 clamp(28px,6vw,56px)/1.2 "JetBrains Mono",monospace;letter-spacing:.08em}
.love+.love{border-top:0}
.lt{display:inline-flex;animation:lv 22s linear infinite}.love.r .lt{animation-direction:reverse}
.lt span{padding-right:.4em;color:transparent;-webkit-text-stroke:1.5px var(--m);text-shadow:0 0 22px rgba(255,43,214,.55)}
.love.r .lt span{-webkit-text-stroke-color:var(--c);text-shadow:0 0 22px rgba(0,217,255,.5)}
@keyframes lv{to{transform:translateX(-50%)}}
.fab{cursor:pointer;font-family:inherit;padding:0;position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:30;width:48px;height:48px;display:grid;place-items:center;border-radius:50%;border:1px solid var(--g);background:var(--pn);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:var(--g);text-decoration:none;font-size:22px;box-shadow:0 0 22px -4px var(--g);transition:.25s}
.fab:hover{background:var(--g);color:#001a10}
footer{text-align:center;padding:30px 5vw 60px;color:var(--mut);font:400 13px "JetBrains Mono",monospace}
.rv{opacity:0;transform:perspective(900px) rotateX(16deg) translateY(36px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}.rv.on{opacity:1;transform:none}
@media(max-width:640px){nav div{gap:10px;font-size:12px}nav a[href="#about"]{display:none}section{padding:80px 6vw}}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}.f::before,.f::after,#boot,.eq b,.lt{animation:none}#boot{display:none}}
</style>
</head>
<body>
<div id="boot"><pre id="bt"></pre><button class="btn p" id="enter" type="button" style="display:none;justify-self:start;margin-top:26px">./vào-trang ♪</button></div>
<canvas id="bg" aria-hidden="true"></canvas>
<div id="glow" aria-hidden="true"></div>
<div class="scan" aria-hidden="true"></div>

<nav><b>&lt;Thế Vĩ/&gt;</b><div><a href="#about">giới-thiệu</a><a href="#skills">năng-lực</a><a href="#work">dự-án</a><a href="#music">âm-nhạc</a><a href="#contact">liên-hệ</a></div></nav>
<button class="fab" id="fab" type="button" aria-label="Bật hoặc tắt nhạc" title="Bật/tắt nhạc">♪</button>

<div class="wrap">
<header class="hero">
  <div class="stage" id="stage">
    <div class="term"><div class="bar"><i></i><i></i><i></i><span>vi@the-vi: ~</span></div>
      <div class="tb"><p><b>vi@the-vi</b>:<u>~</u>$ <span id="ty"></span><em class="cur"></em></p><p class="o" id="out">Thế Vĩ · creative developer · web 3D</p></div></div>
    <h1 class="name" id="name" aria-label="Thế Vĩ"><span class="f" data-t="Thế Vĩ">Thế Vĩ</span></h1>
    <p class="role">&gt; <span id="role"></span><em class="cur"></em></p>
    <div class="cta"><a class="btn p" href="#work">./xem-dự-án</a><a class="btn" href="#music">./nghe-nhạc</a><a class="btn" href="#contact">./liên-hệ</a></div>
  </div>
</header>
<div class="love" aria-hidden="true"><div class="lt"><span>LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ </span><span>LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ </span></div></div>
<div class="love r" aria-hidden="true"><div class="lt"><span>LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ </span><span>LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ LOVE ♥ </span></div></div>

<main>
<section id="about" class="rv">
  <h2><small>$ cat about.txt</small>Xây thế giới 3D ngay trong trình duyệt</h2>
  <p class="lead">Tôi thiết kế và lập trình những trang web có chiều sâu, chuyển động và cá tính riêng. Mỗi dòng code đều hướng tới ba việc: nhanh, đẹp và dùng được trên cả điện thoại lẫn máy tính.</p>
  <div class="stats"><div><span class="n" data-to="50">0</span>+<small>dự án hoàn thành</small></div><div><span class="n" data-to="5">0</span><small>năm kinh nghiệm</small></div><div><span class="n" data-to="100">0</span>%<small>tối ưu cho di động</small></div></div>
</section>

<section id="skills">
  <h2 class="rv"><small>$ ./skills --list</small>Bộ kỹ năng</h2>
  <p class="lead rv">Công cụ tôi dùng hằng ngày để biến ý tưởng thành sản phẩm chạy thật.</p>
  <div class="sk">
    <div class="rv"><div class="bar-l"><span>WebGL / Three.js</span><b>92%</b></div><div class="bt" style="--v:92%"><i></i></div></div>
    <div class="rv"><div class="bar-l"><span>JavaScript</span><b>95%</b></div><div class="bt" style="--v:95%"><i></i></div></div>
    <div class="rv"><div class="bar-l"><span>Thiết kế giao diện</span><b>88%</b></div><div class="bt" style="--v:88%"><i></i></div></div>
    <div class="rv"><div class="bar-l"><span>Shader GLSL</span><b>76%</b></div><div class="bt" style="--v:76%"><i></i></div></div>
    <div class="rv"><div class="bar-l"><span>Hoạt ảnh &amp; tương tác</span><b>90%</b></div><div class="bt" style="--v:90%"><i></i></div></div>
    <div class="rv"><div class="bar-l"><span>Tối ưu hiệu năng</span><b>85%</b></div><div class="bt" style="--v:85%"><i></i></div></div>
  </div>
</section>

<section id="work">
  <h2 class="rv"><small>$ ls ./projects</small>Dự án nổi bật</h2>
  <p class="lead rv">Nội dung mẫu, hãy thay bằng dự án thật của bạn.</p>
  <div class="grid">
    <article class="card rv"><div class="dots"><i></i><i></i><i></i></div><h3>showroom-3d</h3><p>Phòng trưng bày ảo cho thương hiệu, xoay và khám phá bằng chạm hoặc chuột.</p><div class="tags"><i>Three.js</i><i>WebGL</i></div></article>
    <article class="card rv"><div class="dots"><i></i><i></i><i></i></div><h3>landing-scroll</h3><p>Trang giới thiệu sản phẩm cuộn mượt, mô hình chuyển động theo từng đoạn nội dung.</p><div class="tags"><i>Hoạt ảnh</i><i>Responsive</i></div></article>
    <article class="card rv"><div class="dots"><i></i><i></i><i></i></div><h3>portfolio-core</h3><p>Hồ sơ năng lực cá nhân với nhận diện riêng, tải dưới hai giây trên mạng di động.</p><div class="tags"><i>Thiết kế</i><i>Hiệu năng</i></div></article>
  </div>
</section>

<section id="music" class="contact rv">
  <h2><small>$ ./play --track</small>Bản nhạc tôi hay nghe khi code</h2>
  <p class="lead" style="margin-left:auto;margin-right:auto">Bật nhạc lên rồi cuộn tiếp, vừa nghe vừa xem các dự án phía trên.</p>
  <div class="term"><div class="bar"><i></i><i></i><i></i><span>now-playing.sh</span><span class="eq" aria-hidden="true"><b></b><b></b><b></b><b></b></span></div>
    <div class="tb pl"><div class="row"><button class="btn p" id="pp" type="button">▶ phát</button><button class="btn" id="mu" type="button" aria-label="Tắt/bật tiếng">🔊</button></div><div class="pr"><i></i></div><p id="tm">0:00 / 1:00</p></div></div>
</section>

<section id="contact" class="contact rv">
  <h2><small>$ ./contact --open</small>Cùng làm điều gì đó đáng nhớ</h2>
  <p class="lead" style="margin-left:auto;margin-right:auto">Kể cho tôi nghe ý tưởng của bạn, tôi sẽ phản hồi trong vòng một ngày làm việc.</p>
  <div class="term"><div class="bar"><i></i><i></i><i></i><span>contact.sh</span></div>
    <div class="tb"><p>email&nbsp;&nbsp;&nbsp;→ <a href="mailto:hello@example.com">hello@example.com</a></p><p>github&nbsp;&nbsp;→ <a href="https://github.com/" rel="noopener">github.com/the-vi</a></p><p>zalo&nbsp;&nbsp;&nbsp;&nbsp;→ <a href="#contact">0900 000 000</a></p></div></div>
  <button class="btn p" id="copy" type="button">sudo thuê-thế-vĩ</button>
</section>
</main>
<footer>© <span id="y"></span> Thế Vĩ · build bằng canvas, không cần framework</footer>
</div>

<audio id="au" loop preload="auto" src="data:audio/mpeg;base64,"></audio>
<script>
(function(){
const $=s=>document.querySelector(s),au=$('#au'),pp=$('#pp'),mu=$('#mu'),fab=$('#fab'),pr=$('.pr'),tm=$('#tm'),en=$('#enter');
const AC=window.AudioContext||window.webkitAudioContext;
let ctx,gain,src,buf,wa=false,on=false,muted=false,t0=0,off=0;
const fm=t=>Math.floor(t/60)+':'+String(Math.floor(t%60)).padStart(2,'0');
const ui=()=>{document.body.classList.toggle('playing',on);pp.textContent=on?'❚❚ tạm dừng':'▶ phát';fab.textContent=on?'❚❚':'♪'};
const prog=(c,d)=>{pr.style.setProperty('--p',c/d*100+'%');tm.textContent=fm(c)+' / '+fm(d)};
au.volume=.7;
function init(){if(ctx||!AC)return;try{ctx=new AC();gain=ctx.createGain();gain.gain.value=muted?0:.7;gain.connect(ctx.destination);
 const z=ctx.createBufferSource();z.buffer=ctx.createBuffer(1,1,22050);z.connect(ctx.destination);z.start(0);if(ctx.resume)ctx.resume();
 const b=atob(au.src.split(',')[1]),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);
 ctx.decodeAudioData(u.buffer,x=>{buf=x},()=>{})}catch(e){}}
function stopWA(){if(src){try{src.stop()}catch(e){}try{src.disconnect()}catch(e){}src=null}}
function startWA(){if(!ctx||!buf)return false;au.pause();stopWA();if(ctx.resume)ctx.resume();src=ctx.createBufferSource();src.buffer=buf;src.loop=true;src.connect(gain);src.start(0,off%buf.duration);t0=ctx.currentTime-off;wa=true;on=true;ui();return true}
function play(){init();if(wa){startWA();return}au.play().then(()=>{on=true;ui()}).catch(()=>{if(!startWA())tm.textContent='Safari chặn phát nhạc, hãy chạm nút ▶ phát lần nữa'})}
function pause(){if(wa){off=(ctx.currentTime-t0)%buf.duration;stopWA();on=false;ui()}else au.pause()}
const tg=()=>{(on?pause:play)()};
au.addEventListener('play',()=>{if(wa){au.pause();return}on=true;ui()});
au.addEventListener('pause',()=>{if(!wa){on=false;ui()}});
au.addEventListener('timeupdate',()=>{if(!wa)prog(au.currentTime,au.duration||60)});
au.addEventListener('error',()=>{if(!on)startWA()});
setInterval(()=>{if(wa&&on&&buf)prog((ctx.currentTime-t0)%buf.duration,buf.duration)},250);
pp.onclick=tg;fab.onclick=tg;
mu.onclick=()=>{muted=!muted;au.muted=muted;if(gain)gain.gain.value=muted?0:.7;mu.textContent=muted?'🔇':'🔊'};
setTimeout(()=>{en.style.display='inline-block'},1800);
en.addEventListener('click',()=>{document.getElementById('boot').classList.add('out');play();
 setTimeout(()=>{if(!wa&&(au.paused||au.currentTime<.1)){au.pause();if(!startWA())tm.textContent='Không phát được, hãy chạm nút ▶ phát'}},1300);
 setTimeout(()=>window.__go&&window.__go(),450)});
})();
</script>
<script>
(function(){
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches,clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
$('#y').textContent=new Date().getFullYear();

/* Boot */
(function(){const L=['[ ok ] nạp nhân giao diện...','[ ok ] khởi tạo tuyết rơi','[ ok ] biên dịch shader','[ ok ] mã hóa kết nối','> chào mừng đến với Thế Vĩ'],p=$('#bt');let i=0;
 if(reduce)return;const id=setInterval(()=>{if(i>=L.length){clearInterval(id);$('#enter').style.display='inline-block';return}p.textContent+=L[i++]+'\n'},380)})();

/* Gõ chữ */
function type(el,txt,sp,cb){let i=0;(function s(){el.textContent=txt.slice(0,i++);if(i<=txt.length)setTimeout(s,sp);else cb&&cb()})()}
const roles=['Creative Developer','Kỹ sư Web 3D','Nhà thiết kế giao diện','Người dựng thế giới trong trình duyệt'];
if(reduce){$('#ty').textContent='whoami';$('#out').classList.add('on');$('#role').textContent=roles[0]}
else{window.__go=()=>type($('#ty'),'whoami',110,()=>setTimeout(()=>$('#out').classList.add('on'),250));
 let ri=0;(function cyc(){const el=$('#role'),t=roles[ri++%roles.length];type(el,t,60,()=>setTimeout(function d(){const s=el.textContent;if(s.length){el.textContent=s.slice(0,-1);setTimeout(d,28)}else setTimeout(cyc,250)},1700))})()}

/* Tên 3D: đùn khối nhiều lớp */
const nm=$('#name');for(let i=14;i>=1;i--){const s=document.createElement('span');s.textContent='Thế Vĩ';s.setAttribute('aria-hidden','true');s.style.transform=`translateZ(${-i*3.4}px)`;s.style.color=`hsl(155 100% ${32-i*1.9}%)`;nm.appendChild(s)}
const stage=$('#stage'),glow=$('#glow');let tx=0,ty=0,cx=0,cy=0,mx=0,my=0;
addEventListener('pointermove',e=>{mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5;tx=mx*24;ty=-my*16;glow.style.transform=`translate(${e.clientX}px,${e.clientY}px)`});

/* Hiện dần, thanh kỹ năng, đếm số */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('on');io.unobserve(e.target);
 e.target.querySelectorAll&&e.target.querySelectorAll('.n').forEach(n=>{const to=+n.dataset.to;let v=0;(function a(){v+=Math.max(1,to/40);if(v>=to){n.textContent=to}else{n.textContent=Math.floor(v);requestAnimationFrame(a)}})()})}),{threshold:.12});
$$('.rv').forEach(el=>io.observe(el));

/* Thẻ nghiêng 3D */
$$('.card').forEach(c=>{c.addEventListener('pointermove',e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform=`perspective(800px) rotateY(${x*16}deg) rotateX(${-y*16}deg) translateZ(8px)`;c.style.setProperty('--gx',(x+.5)*100+'%');c.style.setProperty('--gy',(y+.5)*100+'%')});c.addEventListener('pointerleave',()=>{c.style.transform=''})});

/* Nút sao chép email */
$('#copy').addEventListener('click',function(){const b=this;try{navigator.clipboard.writeText('hello@example.com')}catch(e){}b.textContent='✔ đã sao chép email';setTimeout(()=>b.textContent='sudo thuê-thế-vĩ',2200)});

/* Tuyết rơi */
const bc=$('#bg'),bx=bc.getContext('2d');let W,H,D,fl=[];
const mk=init=>({x:Math.random()*W,y:init?Math.random()*H:-10,r:Math.random()*2.6+.8,v:Math.random()*.9+.4,s:Math.random()*6.28,w:Math.random()*.02+.005,a:Math.random()*.5+.4});
function draw(dt){bx.clearRect(0,0,W,H);bx.shadowColor='rgba(0,255,156,.7)';
 for(const f of fl){if(dt){f.s+=f.w*dt;f.y+=f.v*dt*(.6+f.r*.25);f.x+=(Math.sin(f.s)*.5+mx*.6)*dt;if(f.y>H+10||f.x<-20||f.x>W+20){Object.assign(f,mk(false))}}
  bx.shadowBlur=f.r>2?8:0;bx.fillStyle='rgba(235,255,248,'+f.a+')';bx.beginPath();bx.arc(f.x,f.y,f.r,0,6.283);bx.fill()}}
function rz(){D=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;bc.width=W*D;bc.height=H*D;bx.setTransform(D,0,0,D,0,0);fl=Array.from({length:Math.round(Math.min(160,W/6+40))},()=>mk(true));if(reduce)draw(0)}
addEventListener('resize',rz);rz();

let last=0;
function loop(now){
 requestAnimationFrame(loop);const dt=Math.min(3,(now-last)/16.67||1);last=now;
 cx+=(tx-cx)*.08;cy+=(ty-cy)*.08;stage.style.transform=`rotateY(${cx}deg) rotateX(${cy}deg)`;
 if(!reduce)draw(dt);
}
requestAnimationFrame(loop);
})();
</script>
</body>
</html>
